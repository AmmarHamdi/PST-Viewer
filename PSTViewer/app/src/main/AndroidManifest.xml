<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Storage permission for reading PST files from external storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- On Android 13+ we need READ_MEDIA_* or use SAF (Storage Access Framework) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PSTViewer"
        android:largeHeap="true">

        <!-- Splash screen — entry point of the app -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PSTViewer.Splash"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main screen: open / pick a PST file -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">

            <!-- Handle opening .pst files from file managers -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:pathPattern=".*\\.pst" />
            </intent-filter>
        </activity>

        <!-- Folder browser -->
        <activity
            android:name=".FolderActivity"
            android:label="@string/folders"
            android:parentActivityName=".MainActivity" />

        <!-- Email list inside a folder -->
        <activity
            android:name=".EmailListActivity"
            android:label="@string/emails"
            android:parentActivityName=".FolderActivity" />

        <!-- Full email view -->
        <activity
            android:name=".EmailDetailActivity"
            android:label="@string/email_detail"
            android:parentActivityName=".EmailListActivity" />

        <!-- FileProvider for sharing attachment files to other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

